MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=lead_multichoice
MYSQL_USER=lmc_dev
MYSQL_PASSWORD=lmc_dev_password
MYSQL_ROOT_PASSWORD=lmc_root_dev_password
MYSQL_CONNECTION_LIMIT=5

# Set false to serve the public website without portal login, registration, tracking, or dashboards.
CLIENT_PORTAL_ENABLED=false

# Optional signing secret for short-lived public tracking sessions; defaults to MYSQL_PASSWORD.
TRACKING_COOKIE_SECRET=

# Only needed for the one-time npm run admin:create command.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_ORGANIZATION=
ADMIN_PASSWORD=

# Required only when the admin media library is enabled.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
